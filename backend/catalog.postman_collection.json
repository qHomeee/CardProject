{
  "info": {
    "name": "Запомни · Каталог",
    "description": "Начните с чтения. Операции записи используйте с ключом только в отдельной тестовой базе. Создание сохраняет полученный ID для следующих запросов.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "editor_key",
      "value": ""
    },
    {
      "key": "deck_id",
      "value": ""
    },
    {
      "key": "card_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Публичное чтение",
      "item": [
        {
          "name": "Поиск наборов",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/decks?q=столицы"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Скачать набор",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/decks/{{deck_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Прочитать карточку",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/decks/{{deck_id}}/cards/{{card_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Создание, изменение и удаление",
      "item": [
        {
          "name": "Создать тестовый набор",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Editor-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{editor_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/decks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Тестовый набор\",\n  \"description\": \"Набор для проверки каталога\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"deck_id\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Заменить название и описание",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Editor-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{editor_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/decks/{{deck_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Тестовый набор после изменения\",\n  \"description\": \"Проверка PUT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать карточку",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Editor-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{editor_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/decks/{{deck_id}}/cards",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Столица Португалии?\",\n  \"answer\": \"Лиссабон\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"card_id\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Заменить вопрос и ответ",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Editor-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{editor_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/v1/decks/{{deck_id}}/cards/{{card_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Столица Испании?\",\n  \"answer\": \"Мадрид\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Удалить карточку",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Editor-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{editor_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/v1/decks/{{deck_id}}/cards/{{card_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Удалить тестовый набор",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Editor-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{editor_key}}",
                  "type": "string"
                },
                {
                  "key": "in",

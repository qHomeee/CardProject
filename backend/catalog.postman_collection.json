                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/v1/decks/{{deck_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
